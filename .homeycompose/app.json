{
  "id": "com.v34.yahla",
  "version": "0.3.1",
  "compatibility": ">=12.3.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "YAHLA Network Guard",
    "sv": "YAHLA Network Guard"
  },
  "description": {
    "en": "Know when a stranger joins your network",
    "sv": "Vet när en främling ansluter till ditt nätverk"
  },
  "category": [
    "security"
  ],
  "brandColor": "#E05000",
  "tags": {
    "en": [
      "network",
      "security",
      "unifi",
      "syslog",
      "intruder",
      "wifi"
    ],
    "sv": [
      "nätverk",
      "säkerhet",
      "unifi",
      "syslog",
      "intrång",
      "wifi"
    ]
  },
  "permissions": [],
  "author": {
    "name": "Peter Persson (Mr-V34)",
    "email": "info@v34.com"
  },
  "contributors": {
    "developers": [
      {
        "name": "B.Frank"
      }
    ]
  },
  "support": "mailto:info@v34.com",
  "source": "https://github.com/Mr-V34/homey-yahla",
  "bugs": {
    "url": "https://github.com/Mr-V34/homey-yahla/issues"
  },
  "homepage": "https://github.com/Mr-V34/homey-yahla/blob/main/docs/MANUAL.md",
  "api": {
    "getStatus": {
      "method": "POST",
      "path": "/status"
    },
    "getDevices": {
      "method": "POST",
      "path": "/devices"
    },
    "unlock": {
      "method": "POST",
      "path": "/unlock"
    },
    "setPin": {
      "method": "POST",
      "path": "/pin"
    },
    "removePin": {
      "method": "POST",
      "path": "/pin/remove"
    },
    "deviceAction": {
      "method": "POST",
      "path": "/device"
    },
    "setConfig": {
      "method": "POST",
      "path": "/config"
    }
  },
  "images": {
    "small": "/assets/images/small.jpg",
    "large": "/assets/images/large.jpg",
    "xlarge": "/assets/images/xlarge.jpg"
  }
}
