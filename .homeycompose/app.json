{
  "id": "com.v34.yahla",
  "version": "0.1.0",
  "compatibility": ">=12.3.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "YAHLA",
    "sv": "YAHLA"
  },
  "description": {
    "en": "Get an alert when an unknown device joins your network.",
    "sv": "Få ett larm när en okänd enhet ansluter till ditt nätverk."
  },
  "category": [
    "security"
  ],
  "brandColor": "#E05000",
  "permissions": [],
  "author": {
    "name": "Peter Persson (Mr-V34)",
    "email": "info@v34.com"
  },
  "contributors": {
    "developers": [
      {
        "name": "B.Frank"
      }
    ]
  },
  "api": {
    "getStatus": {
      "method": "GET",
      "path": "/status"
    },
    "getDevices": {
      "method": "GET",
      "path": "/devices"
    },
    "unlock": {
      "method": "POST",
      "path": "/unlock"
    },
    "setPin": {
      "method": "POST",
      "path": "/pin"
    },
    "removePin": {
      "method": "POST",
      "path": "/pin/remove"
    },
    "deviceAction": {
      "method": "POST",
      "path": "/device"
    },
    "setConfig": {
      "method": "POST",
      "path": "/config"
    }
  },
  "images": {
    "small": "/assets/images/small.jpg",
    "large": "/assets/images/large.jpg",
    "xlarge": "/assets/images/xlarge.jpg"
  }
}
