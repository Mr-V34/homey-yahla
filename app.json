{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "com.v34.yahla",
  "version": "0.3.0",
  "compatibility": ">=12.3.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "YAHLA Network Guard",
    "sv": "YAHLA Network Guard"
  },
  "description": {
    "en": "Know when a stranger joins your network",
    "sv": "Vet när en främling ansluter till ditt nätverk"
  },
  "category": [
    "security"
  ],
  "brandColor": "#E05000",
  "tags": {
    "en": [
      "network",
      "security",
      "unifi",
      "syslog",
      "intruder",
      "wifi"
    ],
    "sv": [
      "nätverk",
      "säkerhet",
      "unifi",
      "syslog",
      "intrång",
      "wifi"
    ]
  },
  "permissions": [],
  "author": {
    "name": "Peter Persson (Mr-V34)",
    "email": "info@v34.com"
  },
  "contributors": {
    "developers": [
      {
        "name": "B.Frank"
      }
    ]
  },
  "support": "mailto:info@v34.com",
  "source": "https://github.com/Mr-V34/homey-yahla",
  "bugs": {
    "url": "https://github.com/Mr-V34/homey-yahla/issues"
  },
  "homepage": "https://github.com/Mr-V34/homey-yahla/blob/main/docs/MANUAL.md",
  "api": {
    "getStatus": {
      "method": "POST",
      "path": "/status"
    },
    "getDevices": {
      "method": "POST",
      "path": "/devices"
    },
    "unlock": {
      "method": "POST",
      "path": "/unlock"
    },
    "setPin": {
      "method": "POST",
      "path": "/pin"
    },
    "removePin": {
      "method": "POST",
      "path": "/pin/remove"
    },
    "deviceAction": {
      "method": "POST",
      "path": "/device"
    },
    "setConfig": {
      "method": "POST",
      "path": "/config"
    }
  },
  "images": {
    "small": "/assets/images/small.jpg",
    "large": "/assets/images/large.jpg",
    "xlarge": "/assets/images/xlarge.jpg"
  },
  "flow": {
    "triggers": [
      {
        "id": "daily_report",
        "title": {
          "en": "The daily report is ready",
          "sv": "Dagsrapporten är klar"
        },
        "hint": {
          "en": "Runs once a day at the hour you chose in the app settings (07:00 unless you changed it), also when the timeline report is turned off. If it does not run, YAHLA is not working.",
          "sv": "Körs en gång om dagen vid det klockslag du valt i appens inställningar (07:00 om du inte ändrat det), även när rapporten i tidslinjen är avstängd. Om kortet inte körs fungerar inte YAHLA."
        },
        "tokens": [
          {
            "name": "report",
            "type": "string",
            "title": {
              "en": "Report",
              "sv": "Rapport"
            },
            "example": {
              "en": "YAHLA is running. Since 2026-01-01 07:00: 1200 log lines, 0 new devices.",
              "sv": "YAHLA lever. Sedan 2026-01-01 07:00: 1200 loggrader, 0 nya enheter."
            }
          }
        ]
      },
      {
        "id": "system_alarm",
        "title": {
          "en": "A system alarm was raised",
          "sv": "Ett systemlarm utlöstes"
        },
        "hint": {
          "en": "Runs when YAHLA itself has a problem. Kind is silence (no logs), resumed (logs again), flood, unknown (unknown log format), forged, tamper (settings changed from outside), socket (cannot listen), socketBack (listening again) or storeProblem (saved data could not be read). Severity is INFO, WARNING, HIGH or CRITICAL.",
          "sv": "Körs när YAHLA själv har ett problem. Typ är silence (inga loggar), resumed (loggar igen), flood (översvämning), unknown (okänt loggformat), forged (förfalskat), tamper (inställningar ändrade utifrån), socket (kan inte lyssna), socketBack (lyssnar igen) eller storeProblem (sparad data kunde inte läsas). Allvarlighet är INFO, WARNING, HIGH eller CRITICAL."
        },
        "tokens": [
          {
            "name": "kind",
            "type": "string",
            "title": {
              "en": "Kind",
              "sv": "Typ"
            },
            "example": {
              "en": "silence",
              "sv": "silence"
            }
          },
          {
            "name": "severity",
            "type": "string",
            "title": {
              "en": "Severity",
              "sv": "Allvarlighet"
            },
            "example": {
              "en": "HIGH",
              "sv": "HIGH"
            }
          },
          {
            "name": "message",
            "type": "string",
            "title": {
              "en": "Message",
              "sv": "Meddelande"
            },
            "example": {
              "en": "No logs for 30 minutes",
              "sv": "Inga loggar på 30 minuter"
            }
          }
        ]
      },
      {
        "id": "unknown_device",
        "title": {
          "en": "An unapproved device was seen",
          "sv": "En ej godkänd enhet upptäcktes"
        },
        "hint": {
          "en": "Runs when a device that is not on your approved list joins the network. Type is new (seen for the first time), unapproved (seen before, still not approved), hop (changed network) or full (the device list is full). Severity is INFO, WARNING, HIGH or CRITICAL, as you set per network.",
          "sv": "Körs när en enhet som inte finns på din godkända lista ansluter till nätverket. Typ är new (sedd för första gången), unapproved (sedd förut, fortfarande inte godkänd), hop (bytte nät) eller full (enhetslistan är full). Allvarlighet är INFO, WARNING, HIGH eller CRITICAL, enligt din inställning per nät."
        },
        "tokens": [
          {
            "name": "type",
            "type": "string",
            "title": {
              "en": "Type",
              "sv": "Typ"
            },
            "example": {
              "en": "new",
              "sv": "new"
            }
          },
          {
            "name": "severity",
            "type": "string",
            "title": {
              "en": "Severity",
              "sv": "Allvarlighet"
            },
            "example": {
              "en": "HIGH",
              "sv": "HIGH"
            }
          },
          {
            "name": "mac",
            "type": "string",
            "title": {
              "en": "MAC address",
              "sv": "MAC-adress"
            },
            "example": {
              "en": "02:00:00:00:00:01",
              "sv": "02:00:00:00:00:01"
            }
          },
          {
            "name": "ip",
            "type": "string",
            "title": {
              "en": "IP address",
              "sv": "IP-adress"
            },
            "example": {
              "en": "192.168.1.50",
              "sv": "192.168.1.50"
            }
          },
          {
            "name": "network",
            "type": "string",
            "title": {
              "en": "Network",
              "sv": "Nätverk"
            },
            "example": {
              "en": "Guest",
              "sv": "Gäst"
            }
          },
          {
            "name": "where",
            "type": "string",
            "title": {
              "en": "Where",
              "sv": "Var"
            },
            "example": {
              "en": "Access point",
              "sv": "Accesspunkt"
            }
          },
          {
            "name": "name",
            "type": "string",
            "title": {
              "en": "Name given by the device",
              "sv": "Enhetens eget namn"
            },
            "example": {
              "en": "phone",
              "sv": "telefon"
            }
          }
        ]
      }
    ]
  }
}