{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "com.v34.yahla",
  "version": "0.1.1",
  "compatibility": ">=12.3.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "YAHLA Network Guard",
    "sv": "YAHLA Network Guard"
  },
  "description": {
    "en": "Know when a stranger joins your network",
    "sv": "Vet när en främling ansluter till ditt nätverk"
  },
  "category": [
    "security"
  ],
  "brandColor": "#E05000",
  "permissions": [],
  "author": {
    "name": "Peter Persson (Mr-V34)",
    "email": "info@v34.com"
  },
  "contributors": {
    "developers": [
      {
        "name": "B.Frank"
      }
    ]
  },
  "api": {
    "getStatus": {
      "method": "POST",
      "path": "/status"
    },
    "getDevices": {
      "method": "POST",
      "path": "/devices"
    },
    "unlock": {
      "method": "POST",
      "path": "/unlock"
    },
    "setPin": {
      "method": "POST",
      "path": "/pin"
    },
    "removePin": {
      "method": "POST",
      "path": "/pin/remove"
    },
    "deviceAction": {
      "method": "POST",
      "path": "/device"
    },
    "setConfig": {
      "method": "POST",
      "path": "/config"
    }
  },
  "images": {
    "small": "/assets/images/small.jpg",
    "large": "/assets/images/large.jpg",
    "xlarge": "/assets/images/xlarge.jpg"
  },
  "flow": {
    "triggers": [
      {
        "id": "daily_report",
        "title": {
          "en": "YAHLA daily report is ready",
          "sv": "YAHLA:s dagsrapport är klar"
        },
        "hint": {
          "en": "Runs once a day at 07:00. If the report does not come, YAHLA is not working.",
          "sv": "Körs en gång om dagen kl. 07:00. Om rapporten uteblir fungerar inte YAHLA."
        },
        "tokens": [
          {
            "name": "report",
            "type": "string",
            "title": {
              "en": "Report",
              "sv": "Rapport"
            },
            "example": {
              "en": "Packets: 1200, new devices: 0",
              "sv": "Paket: 1200, nya enheter: 0"
            }
          }
        ]
      },
      {
        "id": "system_alarm",
        "title": {
          "en": "YAHLA raised an alarm",
          "sv": "YAHLA larmade"
        },
        "hint": {
          "en": "Runs when YAHLA itself has a problem: no logs, a flood, unknown or forged packets, settings changed from outside, or it cannot listen.",
          "sv": "Körs när YAHLA själv har ett problem: inga loggar, en översvämning, okända eller förfalskade paket, inställningar ändrade utifrån, eller att appen inte kan lyssna."
        },
        "tokens": [
          {
            "name": "kind",
            "type": "string",
            "title": {
              "en": "Kind",
              "sv": "Typ"
            },
            "example": {
              "en": "silence",
              "sv": "silence"
            }
          },
          {
            "name": "severity",
            "type": "string",
            "title": {
              "en": "Severity",
              "sv": "Allvarlighet"
            },
            "example": {
              "en": "HIGH",
              "sv": "HIGH"
            }
          },
          {
            "name": "message",
            "type": "string",
            "title": {
              "en": "Message",
              "sv": "Meddelande"
            },
            "example": {
              "en": "No logs for 30 minutes",
              "sv": "Inga loggar på 30 minuter"
            }
          }
        ]
      },
      {
        "id": "unknown_device",
        "title": {
          "en": "An unapproved device was seen",
          "sv": "En ej godkänd enhet upptäcktes"
        },
        "hint": {
          "en": "Runs when a device that is not on your approved list joins the network.",
          "sv": "Körs när en enhet som inte finns på din godkända lista ansluter till nätverket."
        },
        "tokens": [
          {
            "name": "type",
            "type": "string",
            "title": {
              "en": "Type",
              "sv": "Typ"
            },
            "example": {
              "en": "new",
              "sv": "new"
            }
          },
          {
            "name": "severity",
            "type": "string",
            "title": {
              "en": "Severity",
              "sv": "Allvarlighet"
            },
            "example": {
              "en": "HIGH",
              "sv": "HIGH"
            }
          },
          {
            "name": "mac",
            "type": "string",
            "title": {
              "en": "MAC address",
              "sv": "MAC-adress"
            },
            "example": {
              "en": "02:00:00:00:00:01",
              "sv": "02:00:00:00:00:01"
            }
          },
          {
            "name": "ip",
            "type": "string",
            "title": {
              "en": "IP address",
              "sv": "IP-adress"
            },
            "example": {
              "en": "192.168.1.50",
              "sv": "192.168.1.50"
            }
          },
          {
            "name": "network",
            "type": "string",
            "title": {
              "en": "Network",
              "sv": "Nätverk"
            },
            "example": {
              "en": "Guest",
              "sv": "Gäst"
            }
          },
          {
            "name": "where",
            "type": "string",
            "title": {
              "en": "Where",
              "sv": "Var"
            },
            "example": {
              "en": "Access point",
              "sv": "Accesspunkt"
            }
          },
          {
            "name": "name",
            "type": "string",
            "title": {
              "en": "Name given by the device",
              "sv": "Enhetens eget namn"
            },
            "example": {
              "en": "phone",
              "sv": "telefon"
            }
          }
        ]
      }
    ]
  }
}